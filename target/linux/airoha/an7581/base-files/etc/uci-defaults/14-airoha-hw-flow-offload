#!/bin/sh

# OAF (open-app-filter) inspects every packet in netfilter; any flow offload
# (software or PPE hardware fastpath) bypasses the kernel and blinds it.
# Keep both OFF by default; users can re-enable in Network -> Firewall
# at the cost of appfilter statistics/filtering.

. /lib/functions.sh

config_load firewall

uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'

uci commit firewall

exit 0
