 }
 
 #ifdef CONFIG_SKB_EXTENSIONS
+#if IS_ENABLED(CONFIG_NET_AIROHA_SOE)
+/* Immutable delayed PPE binding identity; contains no owned pointers. */
+struct skb_ext_airoha_soe {
+	u64 cookie;
+	u64 observation;
+	u16 foe_hash;
+};
+
+/* Non-reused identities survive driver unbind and module reload. */
+u64 skb_ext_airoha_soe_cookie_alloc(void);
+#endif
