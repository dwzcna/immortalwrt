+void airoha_ppe_soe_flush_sa(struct airoha_ppe *ppe, u8 sa_index, u64 cookie)
+{
+	u32 num_entries, hash;
+
+	if (!ppe)
+		return;
+
+	num_entries = airoha_ppe_get_total_num_entries(ppe);
+
+	spin_lock_bh(&ppe_lock);
+	if (!airoha_ppe_soe_sa_live(ppe, sa_index, cookie))
+		goto unlock;
+	ppe->soe_sa_cookie[sa_index] = 0;
+
+	/* Remove CPU staging and cached flow templates under the same lock as
+	 * all commits. Invalidating only hardware leaves both able to rebind.
+	 */
+	for (hash = 0; hash < num_entries; hash++) {
+		struct airoha_flow_table_entry *e;
+		struct hlist_node *n;
+
+		if (ppe->soe_meta && ppe->soe_meta[hash].valid &&
+		    ppe->soe_meta[hash].cookie == cookie)
+			ppe->soe_meta[hash].valid = 0;
+
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[hash], list) {
+			if (e->soe_cookie != cookie)
+				continue;
+
+			/* The flowtable still owns e; its destroy callback frees it. */
+			hlist_del_init(&e->list);
+			airoha_ppe_foe_flow_unbind(ppe, e);
+		}
+	}
+
+	for (hash = 0; hash < num_entries; hash++) {
+		struct airoha_foe_entry *hwe;
+		u32 state, type;
+
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+		if (!hwe)
+			continue;
+
+		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+		if (state != AIROHA_FOE_STATE_BIND)
+			continue;
+
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+		if (type != PPE_PKT_TYPE_IPV4_HNAPT &&
+		    type != PPE_PKT_TYPE_IPV4_ROUTE)
+			continue;
+
+		if (!(hwe->ipv4.data & AIROHA_FOE_TUNNEL))
+			continue;
+
+		if (FIELD_GET(AIROHA_FOE_ACTDP, hwe->ipv4.data) != sa_index)
+			continue;
+
+		/* NAT-T data and IKE control both use UDP/4500. A stale SOE
+		 * bound entry can otherwise keep sending later IKE_AUTH packets
+		 * to the SOE path after the SA has been deleted.
+		 */
+		hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+				       AIROHA_FOE_STATE_INVALID);
+		airoha_ppe_foe_commit_entry(ppe, hwe, hash, false, NULL);
+	}
+unlock:
+	spin_unlock_bh(&ppe_lock);
+}
