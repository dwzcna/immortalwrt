+static bool
+airoha_ppe_foe_prepare_bridge_subflow_dev(struct airoha_ppe *ppe,
+					  struct net_device *dev,
+					  struct airoha_flow_data *data,
+					  struct airoha_foe_entry *hwe)
+{
+	int err;
+
+	err = airoha_ppe_foe_entry_prepare(ppe->eth, hwe, dev,
+					   PPE_PKT_TYPE_BRIDGE, data, 0, 0);
+	if (err)
+		return false;
+
+	return true;
+}
+
+static struct net_device *
+airoha_ppe_foe_get_bridge_master(struct net_device *dev)
+{
+	struct net_device *master = NULL;
+
+	rcu_read_lock();
+	master = netdev_master_upper_dev_get_rcu(dev);
+	if (master && netif_is_bridge_master(master))
+		dev_hold(master);
+	else
+		master = NULL;
+	rcu_read_unlock();
+
+	return master;
+}
+
+static bool
+airoha_ppe_foe_prepare_bridge_subflow(struct airoha_ppe *ppe,
+				      struct sk_buff *skb,
+				      struct airoha_foe_entry *hwe)
+{
+	struct net_device_path_stack stack;
+	struct ethhdr *eh = eth_hdr(skb);
+	struct net_device_path_ctx ctx = {};
+	struct airoha_flow_data data = {};
+	struct net_device *master, *egress;
+	int err;
+
+	if (!is_valid_ether_addr(eh->h_source) ||
+	    !is_valid_ether_addr(eh->h_dest))
+		return false;
+
+	ether_addr_copy(data.eth.h_dest, eh->h_dest);
+	ether_addr_copy(data.eth.h_source, eh->h_source);
+
+	if (!skb->dev)
+		return false;
+
+	/* Unbound hits can arrive before flowtable creates the L2 master flow
+	 * normally used for subflow binding. Start at the bridge master so the
+	 * FDB selects the destination port instead of reusing the ingress AP.
+	 */
+	master = airoha_ppe_foe_get_bridge_master(skb->dev);
+	if (!master)
+		return false;
+
+	ctx.dev = master;
+	ether_addr_copy(ctx.daddr, eh->h_dest);
+	rcu_read_lock();
+	err = dev_fill_forward_path(&ctx, &stack);
+	if (err || stack.num_paths < 2 ||
+	    stack.path[0].type != DEV_PATH_BRIDGE) {
+		rcu_read_unlock();
+		dev_put(master);
+		return false;
+	}
+
+	/* The path immediately below the bridge is the real egress port. It
+	 * can be an AP netdev (resolved to WDMA by entry_prepare), a direct
+	 * GDM netdev, or a DSA user port.
+	 */
+	egress = (struct net_device *)stack.path[1].dev;
+	if (!egress) {
+		rcu_read_unlock();
+		dev_put(master);
+		return false;
+	}
+	dev_hold(egress);
+	rcu_read_unlock();
+
+	dev_put(master);
+	err = airoha_ppe_foe_prepare_bridge_subflow_dev(ppe, egress, &data,
+							hwe);
+	dev_put(egress);
+
+	return err;
+}
+
+static bool airoha_ppe_soe_sa_live(struct airoha_ppe *ppe, u8 sa_index,
+				   u64 cookie)
+{
+	lockdep_assert_held(&ppe_lock);
+
+	return cookie && sa_index < ARRAY_SIZE(ppe->soe_sa_cookie) &&
+	       ppe->soe_sa_cookie[sa_index] == cookie;
+}
+
+u64 airoha_ppe_soe_register_sa(struct airoha_ppe *ppe, u8 sa_index)
+{
+	u64 cookie = 0;
+
+	if (!ppe || sa_index >= ARRAY_SIZE(ppe->soe_sa_cookie))
+		return 0;
+
+	spin_lock_bh(&ppe_lock);
+#if IS_ENABLED(CONFIG_NET_AIROHA_SOE)
+	cookie = skb_ext_airoha_soe_cookie_alloc();
+#endif
+	ppe->soe_sa_cookie[sa_index] = cookie;
+	spin_unlock_bh(&ppe_lock);
+
+	/* Exhaustion disables PPE binding, but keeps normal SOE operation. */
+	return cookie;
+}
+
+#if IS_ENABLED(CONFIG_NET_AIROHA_SOE)
+static void airoha_ppe_soe_meta_store(struct airoha_ppe_soe_meta *meta,
+				      u32 key_hash, u16 foe_hash, u8 sa_index,
+				      u8 hop, u64 cookie, u64 observation)
+{
+	u8 seen = 1;
+
+	lockdep_assert_held(&ppe_lock);
+
+	if (meta->valid && meta->cookie == cookie &&
+	    meta->key_hash == key_hash &&
+	    meta->foe_hash == foe_hash &&
+	    meta->sa_index == sa_index &&
+	    meta->hop == hop &&
+	    time_before_eq(jiffies, meta->expires))
+		seen = min_t(unsigned int, meta->seen + 1, U8_MAX);
+
+	meta->cookie = cookie;
+	meta->observation = observation;
+	meta->key_hash = key_hash;
+	meta->foe_hash = foe_hash;
+	meta->sa_index = sa_index;
+	meta->hop = hop;
+	meta->seen = seen;
+	meta->expires = jiffies + msecs_to_jiffies(AIROHA_PPE_SOE_META_TIMEOUT_MS);
+	meta->valid = 1;
+}
+
+void airoha_ppe_soe_mark_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
+			     u16 hash, u8 sa_index, u8 hop, u64 cookie)
+{
+	struct skb_ext_airoha_soe *ext;
+	struct airoha_ppe *ppe;
+	u32 ppe_hash_mask;
+
+	if (!dev || !skb)
+		return;
+
+	skb_ext_del(skb, SKB_EXT_AIROHA_SOE);
+
+	ppe = dev->priv;
+	if (!ppe || !ppe->soe_meta)
+		return;
+
+	ppe_hash_mask = airoha_ppe_get_total_num_entries(ppe) - 1;
+	if (hash > ppe_hash_mask || !cookie)
+		return;
+
+	ext = skb_ext_add(skb, SKB_EXT_AIROHA_SOE);
+	if (!ext)
+		return;
+	ext->cookie = cookie;
+	ext->observation = skb_ext_airoha_soe_cookie_alloc();
+	if (!ext->observation) {
+		skb_ext_del(skb, SKB_EXT_AIROHA_SOE);
+		return;
+	}
+	ext->foe_hash = hash;
+
+	/* SOE decrypt completion is CPU-visible before normal routing has
+	 * selected the plaintext egress netdev. Keep the original encrypted FOE
+	 * hash and SA incarnation on the skb so airoha_dev_xmit() can finish
+	 * the PPE entry once the final egress descriptor is known.
+	 */
+	spin_lock_bh(&ppe_lock);
+	if (airoha_ppe_soe_sa_live(ppe, sa_index, cookie)) {
+		airoha_ppe_soe_meta_store(&ppe->soe_meta[hash], hash, hash,
+					  sa_index, hop, cookie, ext->observation);
+		ppe->foe_check_time[hash] = 0;
+	} else {
+		skb_ext_del(skb, SKB_EXT_AIROHA_SOE);
+	}
+	spin_unlock_bh(&ppe_lock);
+}
+
+bool airoha_ppe_soe_skb_marked(struct sk_buff *skb)
+{
+	return skb && skb_ext_find(skb, SKB_EXT_AIROHA_SOE);
+}
+
+void airoha_ppe_soe_xmit_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
+			     struct net_device *netdev)
+{
+	struct airoha_foe_entry entry, tmpl, *hwe;
+	struct airoha_flow_data data = {};
+	struct airoha_ppe_soe_meta *meta;
+	struct skb_ext_airoha_soe *ext;
+	u32 ppe_hash_mask, key_hash;
+	u64 cookie, observation;
+	bool soe_return_path;
+	struct airoha_ppe *ppe;
+	unsigned long expires;
+	u16 hash;
+	int err, l4proto, type;
+	u8 sa_index, hop;
+	u8 seen;
+
+	if (!dev || !skb || !netdev)
+		return;
+
+	ext = skb_ext_find(skb, SKB_EXT_AIROHA_SOE);
+	if (!ext)
+		return;
+	cookie = ext->cookie;
+	observation = ext->observation;
+	key_hash = ext->foe_hash;
+
+	ppe = dev->priv;
+	if (!ppe || !ppe->soe_meta)
+		goto clear_meta;
+
+	ppe_hash_mask = airoha_ppe_get_total_num_entries(ppe) - 1;
+	if (key_hash > ppe_hash_mask)
+		goto clear_meta;
+
+	err = airoha_ppe_soe_fill_inner_ipv4_data(skb, &data, &type, &l4proto);
+	if (err)
+		goto clear_meta;
+
+	spin_lock_bh(&ppe_lock);
+
+	meta = &ppe->soe_meta[key_hash];
+	if (!meta->valid || meta->cookie != cookie ||
+	    meta->observation != observation ||
+	    !airoha_ppe_soe_sa_live(ppe, meta->sa_index, cookie))
+		goto unlock;
+
+	if (meta->key_hash != key_hash)
+		goto unlock;
+
+	expires = meta->expires;
+	if (time_after(jiffies, expires)) {
+		meta->valid = 0;
+		goto unlock;
+	}
+
+	hash = meta->foe_hash;
+	if (hash > ppe_hash_mask) {
+		meta->valid = 0;
+		goto unlock;
+	}
+
+	seen = meta->seen;
+	/* Wait for two CPU-visible packets so the normal egress path is proven
+	 * before the decrypt FOE entry is bound to hardware.
+	 */
+	if (seen <= 2)
+		goto unlock;
+
+	sa_index = meta->sa_index;
+	hop = meta->hop;
+	meta->valid = 0;
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!hwe)
+		goto unlock;
+
+	switch (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1)) {
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+	case PPE_PKT_TYPE_IPV4_ROUTE:
+		break;
+	default:
+		goto unlock;
+	}
+
+	err = airoha_ppe_foe_entry_prepare(ppe->eth, &tmpl, netdev, type,
+					   &data, l4proto, 0);
+	if (err)
+		goto unlock;
+
+	memcpy(&entry, hwe, sizeof(entry));
+	entry.ib1 &= ~(AIROHA_FOE_IB1_BIND_STATE |
+		       AIROHA_FOE_IB1_BIND_KEEPALIVE |
+		       AIROHA_FOE_IB1_BIND_TIMESTAMP);
+	entry.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+				AIROHA_FOE_STATE_BIND) |
+		     AIROHA_FOE_IB1_BIND_TTL;
+	entry.ib1 = (entry.ib1 & (AIROHA_FOE_IB1_BIND_PACKET_TYPE |
+				  AIROHA_FOE_IB1_BIND_UDP)) |
+		    (tmpl.ib1 & ~(AIROHA_FOE_IB1_BIND_PACKET_TYPE |
+				  AIROHA_FOE_IB1_BIND_UDP));
+	entry.ipv4.ib2 = tmpl.ipv4.ib2;
+	entry.ipv4.data = tmpl.ipv4.data;
+	memcpy(&entry.ipv4.l2, &tmpl.ipv4.l2, sizeof(entry.ipv4.l2));
+
+	/* The delayed decrypt commit runs from the normal xmit path, so a
+	 * bond can pass the currently selected lower device here. The SOE
+	 * return rule still has to describe the GDM4-facing recirculation
+	 * descriptor; keeping a GDM2 slave descriptor creates a BND entry that
+	 * forwards plaintext normally instead of re-entering the SOE/PPE path.
+	 */
+	soe_return_path = netif_is_lag_port(netdev);
+	if (!soe_return_path && !netif_is_lag_master(netdev)) {
+		struct airoha_gdm_dev *gdm = netdev_priv(netdev);
+
+		soe_return_path = airoha_is_valid_gdm_dev(ppe->eth, gdm) &&
+				  gdm->port && gdm->port->id == AIROHA_GDM4_IDX;
+	}
+	if (soe_return_path) {
+		entry.ipv4.l2.common.etype = AIROHA_PPE_SOE_MAGIC_GDM4;
+		entry.ipv4.data &= ~AIROHA_FOE_CHANNEL;
+		entry.ipv4.ib2 &= ~AIROHA_FOE_IB2_PSE_PORT;
+		entry.ipv4.ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
+					      FE_PSE_PORT_GDM4) |
+				   AIROHA_FOE_IB2_FAST_PATH;
+	}
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry.ib1) ==
+	    PPE_PKT_TYPE_IPV4_HNAPT)
+		memcpy(&entry.ipv4.new_tuple, &entry.ipv4.orig_tuple,
+		       sizeof(entry.ipv4.new_tuple));
+
+	/* Commit the original decrypt entry only after the normal transmit path
+	 * has provided the final plaintext egress descriptor. Binding it at SOE
+	 * RX completion would miss this device-specific L2/PSE state.
+	 */
+	err = airoha_ppe_foe_entry_set_soe_fields(&entry, sa_index, hop,
+						  AIROHA_PPE_SOE_DEFAULT_TUNNEL_MTU);
+	if (!err)
+		airoha_ppe_foe_commit_entry(ppe, &entry, hash, false, NULL);
+
+unlock:
+	spin_unlock_bh(&ppe_lock);
+clear_meta:
+	skb_ext_del(skb, SKB_EXT_AIROHA_SOE);
+}
