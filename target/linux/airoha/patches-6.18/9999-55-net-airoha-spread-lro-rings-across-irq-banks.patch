Subject: net: airoha: spread LRO rings across the 4 IRQ banks

Adapted from orangeyoo/XR1710G-OpenWrt-iStoreOS-Community patches
9999-16-net-airoha-force-lro-queue-remap and
9999-21-net-airoha-lro-orphan-ring11-fix: upstream queues all 8 CDM LRO
flow queues to rx rings 24-31, which are all pinned to IRQ bank 1, so a
single CPU services every aggregated flow.  Map the 8 flow queues to
rings spread over all 4 IRQ banks (2 rings per bank), drop ring 11
which is covered by no bank pin mask and could never raise RX_DONE,
and bump the descriptor counts of the newly used rings to >=128.

The skb parsing / timestamp / ownership fixes carried by the original
patches are already present upstream.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -43,13 +43,30 @@
 #define TX_DSCP_NUM			1024
 #define RX_DSCP_NUM(_n)			\
 	((_n) ==  2 ? 128 :		\
 	 (_n) ==  4 ? 128 :		\
+	 (_n) ==  5 ? 128 :		\
+	 (_n) ==  6 ? 128 :		\
 	 (_n) == 11 ? 128 :		\
 	 (_n) == 15 ? 128 :		\
+	 (_n) == 21 ? 128 :		\
+	 (_n) == 22 ? 128 :		\
+	 (_n) == 23 ? 128 :		\
+	 (_n) == 24 ? 128 :		\
 	 (_n) ==  0 ? 1024 : 32)
 
 #define AIROHA_LRO_PAGE_ORDER		get_order(SZ_16K)
 #define AIROHA_MAX_NUM_LRO_QUEUES	8
-#define AIROHA_RXQ_LRO_EN_MASK		GENMASK(31, 24)
+/*
+ * The CDM aggregates LRO flows into 8 hw flow queues; airoha_dev_lro_enable()
+ * maps them to the RX rings of this mask in ascending ring order (queue i ->
+ * i-th ring).  Pick rings so that the 8 queues are spread over all 4 IRQ
+ * banks / CPUs (RX_IRQ*_BANK_PIN_MASK):
+ *	bank0 (IRQ eth.0): rings 0, 15		bank1 (eth.1): rings 21, 22, 23, 24
+ *	bank2 (eth.2): ring 5			bank3 (eth.3): ring 6
+ * Every ring here must keep RX_DSCP_NUM() >= 128 descriptors or LRO flows
+ * landing on it starve for RX buffers.
+ */
+#define AIROHA_RXQ_LRO_EN_MASK		(BIT(0) | BIT(5) | BIT(6) | BIT(15) | \
+					 BIT(21) | BIT(22) | BIT(23) | BIT(24))
 #define AIROHA_RXQ_LRO_MAX_AGG_COUNT	64
 #define AIROHA_RXQ_LRO_MAX_AGG_TIME	100
 #define AIROHA_RXQ_LRO_MAX_AGE_TIME	2000
@@ -790,6 +807,14 @@
 	/* EN7581 SoC supports at most 8 LRO rx queues */
 	BUILD_BUG_ON(hweight32(AIROHA_RXQ_LRO_EN_MASK) >
 		     AIROHA_MAX_NUM_LRO_QUEUES);
+	/* Every LRO ring must be pinned to an IRQ bank:
+	 * airoha_qdma_set_rx_done_irq() only enables the per-queue RX_DONE
+	 * interrupt in the banks whose pin mask contains the ring, so an
+	 * uncovered ring would never raise an interrupt and would stall.
+	 */
+	BUILD_BUG_ON(AIROHA_RXQ_LRO_EN_MASK &
+		     ~(RX_IRQ0_BANK_PIN_MASK | RX_IRQ1_BANK_PIN_MASK |
+		       RX_IRQ2_BANK_PIN_MASK | RX_IRQ3_BANK_PIN_MASK));
 
 	return !!(AIROHA_RXQ_LRO_EN_MASK & BIT(qid));
 }
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -716,6 +716,9 @@
 		size = SKB_WITH_OVERHEAD(AIROHA_RX_LEN(q->buf_size));
 		size = min_t(u32, size, AIROHA_MAX_RX_SIZE);
 		airoha_fe_lro_rxq_enable(eth, qdma_id, lro_queue_index, i,
 					 size);
+		dev_info(eth->dev,
+			 "QDMA%d LRO queue %d -> RX ring %d\n",
+			 qdma_id, lro_queue_index, i);
 		lro_queue_index++;
 	}
 }
@@ -1371,7 +1374,7 @@
 		done += cur;
 	} while (cur && done < budget);
 
-	if (done < budget && napi_complete(napi)) {
+	if (done < budget && napi_complete_done(napi, done)) {
 		struct airoha_qdma *qdma = q->qdma;
 		int qid = q - &qdma->q_rx[0];
 
@@ -1732,7 +1735,7 @@
 	}
 #endif
 
-	if (done < budget && napi_complete(napi))
+	if (done < budget && napi_complete_done(napi, done))
 		airoha_qdma_irq_enable(&qdma->irq_banks[0], QDMA_INT_REG_IDX0,
 				       TX_DONE_INT_MASK(id));
 
