From: liujixings <liujixings@outlook.com>
Subject: [PATCH] net: airoha: preserve native AN7581 L2B ingress keys

Native L2B entries use a different layout from the software bridge
profile and IPv4 entries. Writing the template ib2 at offset 16 corrupts
the learned source MAC; the native forwarding control is at offset 44.
Keep the template and IPv4/IPv6 subflow paths unchanged. Add a distinct
native layout, preserve its learned key through the final hardware commit,
and decode it consistently.
Do not redirect native entries through an unverified NPU stats layout.

This is the PR #11 change adapted to run after the XR1710G bridge
fallback and VLAN-aware subflow patches already present in this tree.

Signed-off-by: liujixings <liujixings@outlook.com>
Signed-off-by: naoki66 <naoki66@qq.com>
---
Index: linux-6.18.60/drivers/net/ethernet/airoha/airoha_eth.h
===================================================================
--- linux-6.18.60.orig/drivers/net/ethernet/airoha/airoha_eth.h	2026-11-24 03:09:36.833480747 +0000
+++ linux-6.18.60/drivers/net/ethernet/airoha/airoha_eth.h	2026-11-24 03:09:36.831480759 +0000
@@ -425,6 +425,26 @@
 	struct airoha_foe_mac_info l2;
 };
 
+/* AN7581 native L2B hardware entry. Keep bridge as the software template. */
+struct airoha_foe_l2b {
+	u32 dest_mac_hi;
+	u16 ingress_vlan;
+	u16 dest_mac_lo;
+	u32 key;
+	u32 src_mac_hi;
+	u16 reserved0;
+	u16 src_mac_lo;
+	u32 reserved1[4];
+	u32 data;
+	u32 ib2;
+	u16 vlan1;
+	u16 etype;
+	u32 reserved2;
+	u16 vlan2;
+	u16 reserved3;
+	u32 reserved4;
+};
+
 struct airoha_foe_ipv4_tuple {
 	u32 src_ip;
 	u32 dest_ip;
@@ -501,6 +521,7 @@
 			u32 ib1;
 			union {
 				struct airoha_foe_bridge bridge;
+				struct airoha_foe_l2b l2b;
 				struct airoha_foe_ipv4 ipv4;
 				struct airoha_foe_ipv4_dslite dslite;
 				struct airoha_foe_ipv6 ipv6;
@@ -511,6 +532,12 @@
 	};
 };
 
+static_assert(offsetof(struct airoha_foe_entry, l2b.src_mac_hi) == 16);
+static_assert(offsetof(struct airoha_foe_entry, l2b.data) == 40);
+static_assert(offsetof(struct airoha_foe_entry, l2b.ib2) == 44);
+static_assert(offsetof(struct airoha_foe_entry, l2b.vlan1) == 48);
+static_assert(sizeof(struct airoha_foe_entry) == PPE_ENTRY_SIZE);
+
 struct airoha_foe_stats {
 	u32 bytes;
 	u32 packets;
Index: linux-6.18.60/drivers/net/ethernet/airoha/airoha_ppe.c
===================================================================
--- linux-6.18.60.orig/drivers/net/ethernet/airoha/airoha_ppe.c	2026-11-24 03:09:36.833480747 +0000
+++ linux-6.18.60/drivers/net/ethernet/airoha/airoha_ppe.c	2026-11-24 03:10:10.459288995 +0000
@@ -1195,6 +1195,10 @@
 	int ppe_num_stats_entries;
 	u8 nbq;
 
+	/* No verified NPU counter layout for native AN7581 L2B entries. */
+	if (airoha_is_7581(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE)
+		return;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
@@ -1369,7 +1373,21 @@
 			return -EIO;
 	}
 
-	memcpy(&hwe->d, &e->d, sizeof(*hwe) - sizeof(hwe->ib1));
+	if (airoha_is_7581(eth) &&
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
+	    PPE_PKT_TYPE_BRIDGE &&
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->ib1) ==
+	    PPE_PKT_TYPE_BRIDGE) {
+		struct airoha_foe_l2b native_l2 = hwe->l2b;
+
+		memcpy(&hwe->d, &e->d, sizeof(*hwe) - sizeof(hwe->ib1));
+		/* The generic copy uses the software bridge layout. Restore the
+		 * native learned key, while keeping the new forwarding fields. */
+		memcpy(&hwe->l2b, &native_l2,
+		       offsetof(struct airoha_foe_l2b, data));
+	} else {
+		memcpy(&hwe->d, &e->d, sizeof(*hwe) - sizeof(hwe->ib1));
+	}
 	wmb();
 
 	e->ib1 &= ~AIROHA_FOE_IB1_BIND_TIMESTAMP;
@@ -1574,6 +1592,15 @@
 	hwe.ib1 = (hwe.ib1 & mask) | (bridge->ib1 & ~mask);
 
 	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe.ib1);
+	if (airoha_is_7581(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE) {
+		/* Preserve the hardware-learned ingress key, including source MAC. */
+		hwe.l2b.data = bridge->bridge.data;
+		hwe.l2b.ib2 = bridge->bridge.ib2;
+		hwe.l2b.vlan1 = bridge->bridge.l2.common.vlan1;
+		hwe.l2b.vlan2 = bridge->bridge.l2.common.vlan2;
+		hwe.l2b.etype = bridge->bridge.l2.common.etype;
+		goto commit;
+	}
 	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
 		memcpy(&hwe.ipv6.l2, &bridge->bridge.l2,
 		       sizeof(hwe.ipv6.l2));
@@ -1593,6 +1620,7 @@
 	}
 
 	hwe.bridge.data = bridge->bridge.data;
+commit:
 	return airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan, owner);
 }
 
@@ -2199,6 +2227,7 @@
 	struct airoha_foe_entry *hwe;
 	bool commit_done = false;
 	bool bridge_ready = false;
+	bool native_l2b;
 	bool local = airoha_ppe_foe_skb_is_local(skb);
 	struct hlist_node *n;
 	u32 index, state;
@@ -2217,6 +2246,16 @@
 	if (state == AIROHA_FOE_STATE_BIND)
 		goto unlock;
 
+	native_l2b = airoha_is_7581(ppe->eth) &&
+		FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
+		PPE_PKT_TYPE_BRIDGE;
+	if (native_l2b) {
+		/* Native L2B does not use the software L4 hash bucket. */
+		if (local)
+			goto unlock;
+		goto l2_lookup;
+	}
+
 	index = airoha_ppe_foe_get_entry_hash(ppe, hwe);
 	hlist_for_each_entry_safe(e, n, &ppe->foe_flow[index], list) {
 		if (e->type == FLOW_TYPE_L2_SUBFLOW) {
@@ -2247,6 +2286,7 @@
 	if (local)
 		goto unlock;
 
+l2_lookup:
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
@@ -2679,8 +2719,15 @@
 	struct airoha_eth *eth = ppe->eth;
 	int ppe_num_stats_entries;
 	struct airoha_npu *npu;
+	struct airoha_foe_entry *hwe;
 	u32 index;
 
+	hwe = ppe->foe + hash * sizeof(*hwe);
+	if (airoha_is_7581(eth) &&
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, READ_ONCE(hwe->ib1)) ==
+	    PPE_PKT_TYPE_BRIDGE)
+		return;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
