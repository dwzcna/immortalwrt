+static unsigned int mt7996_dscp_to_up(unsigned int dscp)
+{
+	unsigned int ret = dscp >> 3;
+
+	switch (dscp) {
+	case 10:
+	case 12:
+	case 14:
+		ret = 0;
+		break;
+	case 16:
+		ret = 0;
+		break;
+	case 18:
+	case 20:
+	case 22:
+		ret = 3;
+		break;
+	case 24:
+	case 26:
+	case 28:
+	case 30:
+		ret = 4;
+		break;
+	case 44:
+	case 46:
+		ret = 6;
+		break;
+	case 48:
+		ret = 7;
+		break;
+	}
+
+	return ret;
+}
+
