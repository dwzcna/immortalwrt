--- /dev/null
+++ b/modules/luci-mod-status/htdocs/luci-static/resources/view/status/logs.js
@@ -0,0 +1,45 @@
+'use strict';
+'require view';
+'require ui';
+'require dom';
+
+/*
+ * Tabbed container: merges the log status pages into one view with
+ * client-side tab switching.  Each pane lazy-loads the original view
+ * logic on first activation, so switching tabs no longer reloads the
+ * entire page.  Hidden panes neither render nor poll until visited.
+ */
+
+const TABS = [
+	['syslog', _('System Log'), 'view.status.syslog_impl'],
+	['dmesg', _('Kernel Log'), 'view.status.dmesg_impl'],
+];
+
+return view.extend({
+	render() {
+		const group = E('div', { 'class': 'cbi-section-node-tabbed' });
+		const wrapper = E('div', {}, group);
+
+		for (const [name, title, path] of TABS) {
+			const pane = E('div', {
+				'data-tab': name,
+				'data-tab-title': title
+			}, E('div', { 'class': 'spinning' }, _('Loading view…')));
+
+			pane.addEventListener('cbi-tab-active', function load() {
+				pane.removeEventListener('cbi-tab-active', load);
+				L.require(path).then(inst =>
+					Promise.resolve(inst.load ? inst.load() : null)
+						.then(data => inst.render(data)))
+				.then(nodes => dom.content(pane, nodes))
+				.catch(err => dom.content(pane,
+					E('div', { 'class': 'alert-message error' }, String(err))));
+			});
+
+			group.appendChild(pane);
+		}
+
+		ui.tabs.initTabGroup(group.childNodes);
+		return wrapper;
+	}
+});
