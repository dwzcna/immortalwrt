index 0000000000..4735f6e91c
--- /dev/null
+++ b/applications/luci-app-commands/htdocs/luci-static/resources/view/commands/dashboard_impl.js
@@ -0,0 +1,185 @@
+'use strict';
+'require view';
+'require uci';
+'require dom';
+'require request';
+
+/*
+ * JS port of the luci-app-commands dashboard (originally the server-side
+ * ucode template commands.ut), used as a lazy-loaded pane of the tabbed
+ * commands container.  The run/download/link dispatcher endpoints are
+ * unchanged.
+ */
+
+const cmdCSS = `
+	.commands {
+		display: flex;
+		flex-wrap: wrap;
+	}
+
+	.commandbox {
+		flex: 0 0 30%;
+		margin: .5em;
+		display: flex;
+		flex-direction: column;
+	}
+
+	.commandbox > p,
+	.commandbox > p > * {
+		display: block;
+	}
+
+	.commandbox div {
+		margin-top: auto;
+	}
+`;
+
+return view.extend({
+
+	__init__() {},
+
+	load() {
+		return uci.load('luci');
+	},
+
+	commandRun(ev, id) {
+		const field = document.getElementById(id);
+		const legend = document.getElementById('command-rc-legend');
+		const output = document.getElementById('command-rc-output');
+
+		if (!legend || !output)
+			return;
+
+		output.innerHTML =
+			'<img src="' + L.resource('icons/loading.svg') + '" alt="' + _('Loading') + '" style="vertical-align:middle" /> ' +
+			_('Waiting for command to complete...');
+
+		legend.parentNode.style.display = 'block';
+		legend.style.display = 'inline';
+
+		const options = field ? { query: { args: field.value } } : null;
+		request.get(L.url('admin/system/commands/run', id), options).then(reply => {
+			const st = reply.json();
+
+			if (st.binary)
+				st.stdout = '[' + _('Binary data not displayed, download instead.') + ']';
+
+			output.innerHTML = String.format(
+				'<pre><strong># %h\n</strong>%h<span style="color:red">%h</span></pre>' +
+				'<div class="alert-message warning">%h (%h %d)</div>',
+				st.command, st.stdout, st.stderr,
+				(st.exitcode == 0) ? _('Command successful') : _('Command failed'),
+				_('Code:'), st.exitcode);
+		}).catch(() => {
+			output.innerHTML = '<span class="error">%h</span>'.format(_('Failed to execute command!'));
+		}).finally(() => {
+			legend.style.display = 'none';
+			location.hash = '#output';
+		});
+
+		ev.preventDefault();
+	},
+
+	commandDownload(ev, id) {
+		const field = document.getElementById(id);
+		const args = field ? encodeURIComponent(field.value) : null;
+
+		location.href = L.url('admin/system/commands/download', id) + (args ? '/' + args : '');
+
+		ev.preventDefault();
+	},
+
+	commandLink(ev, id) {
+		const legend = document.getElementById('command-rc-legend');
+		const output = document.getElementById('command-rc-output');
+
+		const field = document.getElementById(id);
+		const args = field ? encodeURIComponent(field.value) : null;
+
+		if (!legend || !output)
+			return;
+
+		const prefix = location.protocol + '//' + location.host + L.url('command') + '/';
+		const suffix = (args ? '?args=' + args : '');
+
+		const link = prefix + id + suffix;
+		const linkNodownload = prefix + id + 's' + suffix;
+
+		legend.style.display = 'none';
+		output.parentNode.style.display = 'block';
+		output.innerHTML = String.format(
+			'<div class="alert-message"><p>%h <a href="%s">%s</a></p><p>%h <a href="%s">%s</a></p></div>',
+			_('Download execution result'), link, link,
+			_('Or display result'), linkNodownload, linkNodownload);
+
+		location.hash = '#output';
+
+		ev.preventDefault();
+	},
+
+	render() {
+		const commands = uci.sections('luci', 'command');
+		const boxes = [];
+
+		for (const command of commands) {
+			const children = [
+				E('h3', {}, command.name),
+				E('p', {}, [ _('Command:'), ' ', E('code', {}, command.command) ])
+			];
+
+			if (command.description)
+				children.push(E('p', {}, E('em', {}, command.description)));
+
+			if (command.param == '1')
+				children.push(E('p', {}, [ _('Arguments:'), ' ',
+					E('input', { type: 'text', id: command['.name'] }) ]));
+
+			const buttons = [
+				E('button', {
+					'class': 'cbi-button cbi-button-apply',
+					'click': (ev) => this.commandRun(ev, command['.name'])
+				}, _('Run')),
+				' ',
+				E('button', {
+					'class': 'cbi-button cbi-button-download',
+					'click': (ev) => this.commandDownload(ev, command['.name'])
+				}, _('Download'))
+			];
+
+			if (command.public == '1')
+				buttons.push(' ',
+					E('button', {
+						'class': 'cbi-button cbi-button-link',
+						'click': (ev) => this.commandLink(ev, command['.name'])
+					}, _('Link')));
+
+			children.push(E('div', {}, buttons));
+
+			boxes.push(E('div', { 'class': 'commandbox' }, children));
+		}
+
+		const body = boxes.length
+			? E('div', { 'class': 'commands' }, boxes)
+			: E('div', { 'class': 'cbi-section' },
+				E('div', { 'class': 'table cbi-section-table' },
+					E('div', { 'class': 'tr cbi-section-table-row' },
+						E('p', {}, E('em', {}, _('This section contains no values yet'))))));
+
+		return E([], [
+			E('style', { type: 'text/css' }, cmdCSS),
+			E('div', { 'class': 'cbi-map' }, [
+				E('h2', { 'name': 'content' }, _('Custom Commands')),
+				body,
+				E('a', { 'name': 'output' })
+			]),
+			E('fieldset', { 'class': 'cbi-section', 'style': 'display:none' }, [
+				E('legend', { 'id': 'command-rc-legend' }, _('Collecting data...')),
+				E('span', { 'id': 'command-rc-output' })
+			])
+		]);
+	},
+
+	handleSave: null,
+	handleSaveApply: null,
+	handleReset: null
+});
