diff --git a/utils/ttyd/patches/101-run-uv-loop-for-lws-5.1.patch b/utils/ttyd/patches/101-run-uv-loop-for-lws-5.1.patch
new file mode 100644
index 000000000..1c74e25e0
--- /dev/null
+++ b/utils/ttyd/patches/101-run-uv-loop-for-lws-5.1.patch
@@ -0,0 +1,22 @@
+Subject: ttyd: run the libuv loop directly for libwebsockets 5.1
+
+libwebsockets 5.1 changed lws_service() on libuv to run a single loop
+turn (UV_RUN_ONCE) instead of blocking until the loop is stopped, so
+ttyd exits right after printing "Listening on port". Since ttyd owns
+the foreign loop, run it directly with uv_run(UV_RUN_DEFAULT), which
+restores the pre-5.1 blocking behaviour and keeps the existing
+uv_stop() / signal-driven exit behaviour.
+
+Backported from upstream PR: https://github.com/tsl0922/ttyd/pull/1589
+
+--- a/src/server.c
++++ b/src/server.c
+@@ -610,7 +610,7 @@
+     uv_signal_start(&signals[i], signal_cb, sig_nums[i]);
+   }
+ 
+-  lws_service(context, 0);
++  uv_run(server->loop, UV_RUN_DEFAULT);
+ 
+   for (int i = 0; i < sig_count; i++) {
+     uv_signal_stop(&signals[i]);
